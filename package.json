{
  "name": "dsh-memory",
  "version": "0.2.0",
  "description": "Layered long-term memory for DeepSeek Harness: L0 conversation capture → L1 atomic memories (chat/work families) → L2 scenes → L3 persona, with session memory modes, hybrid RRF recall, distill route chains and a memory workbench. 分层蒸馏长期记忆插件",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "long-term-memory",
    "layered-memory"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --import ./test/hooks-register.mjs --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
